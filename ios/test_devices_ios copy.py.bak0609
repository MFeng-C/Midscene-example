"""
iOS 原生 App UI 自动化测试脚本
WDA: http://172.16.1.34:8100
Appium: http://172.16.1.34:4723
iOS UDID: 7720cc4ebea57931c047c2cdc0a9fbc5f6cf0c5c
Bundle ID: com.juphoon.record.ios
测试流程：客户登录 -> 我的 -> 退出登录
支持循环执行
"""

import time
import os
import sys
from appium import webdriver
from appium.options.ios import XCUITestOptions
from appium.webdriver.common.appiumby import AppiumBy
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC


# 配置
WDA_URL = "http://172.16.1.34:8100"
APPIUM_URL = "http://172.16.1.34:4723"
UDID = "7720cc4ebea57931c047c2cdc0a9fbc5f6cf0c5c"
BUNDLE_ID = "com.juphoon.record.ios"

PLATFORM_VERSION = "17"

# 截图保存目录
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SCREENSHOT_DIR = os.path.join(SCRIPT_DIR, "screenshots")
os.makedirs(SCREENSHOT_DIR, exist_ok=True)


def get_desired_caps():
    """获取 Appium 配置"""
    options = XCUITestOptions()
    options.set_capability("platformName", "iOS")
    options.set_capability("automationName", "XCUITest")
    options.set_capability("deviceName", "iPhone")
    options.set_capability("platformVersion", PLATFORM_VERSION)
    options.set_capability("udid", UDID)
    options.set_capability("bundleId", BUNDLE_ID)
    options.set_capability("webDriverAgentUrl", WDA_URL)
    options.set_capability("noReset", True)
    options.set_capability("fullReset", False)
    options.set_capability("newCommandTimeout", 300)
    options.set_capability("wdaConnectionTimeout", 60000)
    options.set_capability("autoAcceptAlerts", True)
    options.set_capability("skipLogCapture", True)
    options.set_capability("enableWebviewDetails", True)
    options.set_capability("autoWebview", False)  # 改为手动切换
    options.set_capability("ensureWebviewsHavePages", True)
    options.set_capability("webviewConnectTimeout", 30000)
    options.set_capability("webkitDebugProxyPort", 9221)
    options.set_capability("showXcodeLog", True)
    options.set_capability("newCommandTimeout", 60)

    options.set_capability("webviewConnectRetries", 30)
    options.set_capability("nativeWebTap", True)
    options.set_capability("processArguments", {"args": ["-StartInBackground", "YES"]})
    return options


def screenshot(driver, name):
    """截图保存"""
    path = os.path.join(SCREENSHOT_DIR, f"{name}.png")
    try:
        driver.save_screenshot(path)
        print(f"    截图: {path}")
    except Exception as e:
        print(f"    截图失败: {e}")
    return path


def find_element(driver, locators, timeout=15):
    """查找单个元素，支持多种定位方式

    Args:
        driver: WebDriver 实例
        locators: [(loc_type, loc_value), ...] 列表
        timeout: 超时时间（秒）

    Returns:
        找到的元素，否则返回 None
    """
    start = time.time()
    last_error = None

    while time.time() - start < timeout:
        for loc_type, loc_value in locators:
            try:
                if loc_type == "accessibility id":
                    elem = driver.find_element(AppiumBy.ACCESSIBILITY_ID, loc_value)
                elif loc_type == "xpath":
                    elem = driver.find_element(By.XPATH, loc_value)
                elif loc_type == "class name":
                    elem = driver.find_element(By.CLASS_NAME, loc_value)
                elif loc_type == "predicate":
                    elem = driver.find_element(AppiumBy.IOS_PREDICATE, loc_value)
                else:
                    elem = driver.find_element(By.XPATH, loc_value)

                if elem.is_displayed():
                    return elem
            except Exception as e:
                last_error = e
        time.sleep(0.5)

    raise Exception(f"未找到元素 {locators}: {last_error}")


def click_element(driver, locators, check_enabled=True):
    """尝试多种方式点击元素"""
    for loc_type, loc_value in locators:
        try:
            if loc_type == "accessibility id":
                elem = driver.find_element(AppiumBy.ACCESSIBILITY_ID, loc_value)
            elif loc_type == "xpath":
                elem = driver.find_element(By.XPATH, loc_value)
            elif loc_type == "class name":
                elem = driver.find_element(By.CLASS_NAME, loc_value)
            elif loc_type == "predicate":
                elem = driver.find_element(AppiumBy.IOS_PREDICATE, loc_value)
            else:
                elem = driver.find_element(By.XPATH, loc_value)

            if not elem.is_displayed():
                continue
            if check_enabled and not elem.is_enabled():
                time.sleep(0.5)
                continue

            elem.click()
            time.sleep(0.3)
            return True, loc_type
        except:
            continue
    return False, None


def input_text(driver, locators, text, clear_first=True):
    """清空并输入文本"""
    for loc_type, loc_value in locators:
        try:
            if loc_type == "accessibility id":
                elem = driver.find_element(AppiumBy.ACCESSIBILITY_ID, loc_value)
            elif loc_type == "xpath":
                elem = driver.find_element(By.XPATH, loc_value)
            elif loc_type == "class name":
                elem = driver.find_element(By.CLASS_NAME, loc_value)
            else:
                elem = driver.find_element(By.XPATH, loc_value)

            if elem and elem.is_displayed():
                elem.click()
                time.sleep(0.3)
                if clear_first:
                    try:
                        elem.clear()
                        time.sleep(0.2)
                    except:
                        pass
                elem.send_keys(text)
                return True
        except Exception as e:
            print(f"    input_text 失败: {e}")
            continue
    return False


def run_test_cycle(driver, cycle_num):
    """执行一次测试循环"""
    print(f"\n{'='*50}")
    print(f"开始第 {cycle_num} 次测试")
    print(f"{'='*50}")

    # 1. 启动 App
    print("\n[Step 1] 启动 App...")
    try:
        driver.activate_app(BUNDLE_ID)
        print(f"    第{cycle_num}次 - 已启动 App")
    except Exception as e:
        print(f"    第{cycle_num}次 - 启动 App: {e}")
    time.sleep(15)
    screenshot(driver, f"step1_launch_{cycle_num}")

    # 2. 点击客户登录
    print("\n[Step 2] 点击客户登录...")

    locators = [
        ("xpath", '//XCUIElementTypeButton[@name="客户登录"]'),
        ("xpath", '//*[contains(@name,"客户登录")]'),
        ("accessibility id", "客户登录"),
    ]

    success, loc_type = click_element(driver, locators)
    if success:
        print(f"    第{cycle_num}次 - 已点击客户登录({loc_type})")
    else:
        screenshot(driver, f"error_step2_{cycle_num}")
        print(f"    页面元素: {driver.page_source[:1000]}")
        raise Exception(f"第{cycle_num}次 - 未找到'客户登录'按钮")

    time.sleep(4)
    screenshot(driver, f"step2_customer_login_{cycle_num}")

    # 3. 输入身份证号
    print("\n[Step 3] 输入身份证号...")

    id_card_locators = [
        ("xpath", '//XCUIElementTypeTextField[@placeholderValue="请输入身份证号码"]'),
        ("xpath", '//XCUIElementTypeTextField[contains(@placeholderValue,"身份证")]'),
        ("xpath", '//XCUIElementTypeTextField[@value="411525200006040977"]'),
    ]

    success = input_text(driver, id_card_locators, "411525200006040977", clear_first=True)
    if success:
        print(f"    第{cycle_num}次 - 已输入身份证号")
    else:
        screenshot(driver, f"error_step3_{cycle_num}")
        text_fields = driver.find_elements(By.CLASS_NAME, "XCUIElementTypeTextField")
        print(f"    页面文本框数量: {len(text_fields)}")
        for idx, tf in enumerate(text_fields):
            print(f"    文本框{idx}: value={tf.get_attribute('value')}, placeholder={tf.get_attribute('placeholderValue')}")
        raise Exception(f"第{cycle_num}次 - 未找到身份证输入框")

    time.sleep(0.5)
    screenshot(driver, f"step3_id_card_{cycle_num}")

    # 4. 输入密码
    print("\n[Step 4] 输入密码...")

    password_locators = [
        ("xpath", '//XCUIElementTypeSecureTextField[@placeholderValue="请输入登录密码"]'),
        ("xpath", '//XCUIElementTypeSecureTextField[contains(@placeholderValue,"密码")]'),
    ]

    success = input_text(driver, password_locators, "Record123456", clear_first=False)
    if success:
        print(f"    第{cycle_num}次 - 已输入密码")
    else:
        screenshot(driver, f"error_step4_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到密码输入框")

    time.sleep(0.5)
    screenshot(driver, f"step4_password_{cycle_num}")

    # 5. 输入验证码
    print("\n[Step 5] 输入验证码...")

    captcha_locators = [
        ("xpath", '//XCUIElementTypeTextField[@placeholderValue="请输入验证码"]'),
        ("xpath", '//XCUIElementTypeTextField[contains(@placeholderValue,"验证码")]'),
    ]

    success = input_text(driver, captcha_locators, "0000", clear_first=True)
    if success:
        print(f"    第{cycle_num}次 - 已输入验证码")
    else:
        screenshot(driver, f"error_step5_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到验证码输入框")

    time.sleep(0.5)
    screenshot(driver, f"step5_captcha_{cycle_num}")

    # 6. 点击登录按钮
    print("\n[Step 6] 点击登录按钮...")

    login_locators = [
        ("xpath", '//XCUIElementTypeButton[@name="登录"]'),
        ("xpath", '//XCUIElementTypeButton[contains(@name,"登录")]'),
    ]

    success, loc_type = click_element(driver, login_locators)
    if success:
        print(f"    第{cycle_num}次 - 已点击登录按钮({loc_type})")
    else:
        screenshot(driver, f"error_step6_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到'登录'按钮")

    # 等待登录完成 - 等待loading/过渡动画结束，页面稳定
    print(f"    第{cycle_num}次 - 等待页面加载...")
    page_stable = False
    for wait_idx in range(30):  # 最多等 30 秒
        time.sleep(1)
        source = driver.page_source
        # loading 状态：白屏+loading动画，或仍在登录页
        # 如果页面包含"我的"且不包含"请输入验证码"(表单已提交)就算稳定
        if '我的' in source and '请输入验证码' not in source:
            page_stable = True
            print(f"    第{cycle_num}次 - 页面加载完成，等待了 {wait_idx+1} 秒")
            break
        if wait_idx % 5 == 4:
            print(f"    第{cycle_num}次 - 仍在加载中... ({wait_idx+1}s)")

    time.sleep(2)  # 再等一下确保UI完全渲染
    screenshot(driver, f"step6_after_login_{cycle_num}")

    if not page_stable:
        print(f"    第{cycle_num}次 - 警告：页面加载超时")

    # 7. 点击【我的】
    print("\n[Step 7] 点击【我的】...")

    # 等待"我的"按钮可见 - 使用 CONTAINS 匹配包含"我的"的 name
    my_btn = None
    for wait_idx in range(15):
        try:
            all_buttons = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeButton')
            for btn in all_buttons:
                name = btn.get_attribute('name') or ''
                label = btn.get_attribute('label') or ''
                # name 或 label 包含"我的"且按钮可见
                if ('我的' in name or '我的' in label) and btn.is_displayed() and btn.is_enabled():
                    my_btn = btn
                    print(f"    第{cycle_num}次 - 找到'我的'按钮(name={name}, label={label})，等待了 {wait_idx}s")
                    break
            if my_btn:
                break
        except:
            pass
        time.sleep(1)

    if not my_btn:
        screenshot(driver, f"error_step7_{cycle_num}")
        # 打印所有可见按钮帮助调试
        try:
            all_buttons = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeButton')
            visible = [b for b in all_buttons if b.is_displayed()]
            print(f"    页面可见按钮数: {len(visible)}")
            for b in visible:
                print(f"    按钮: name={b.get_attribute('name')}, label={b.get_attribute('label')}")
        except:
            pass
        raise Exception(f"第{cycle_num}次 - 未找到'我的'按钮")

    my_btn.click()
    print(f"    第{cycle_num}次 - 已点击【我的】")
    time.sleep(2)
    screenshot(driver, f"step7_my_page_{cycle_num}")

    # 验证"我的"页面内容
    if '退出登录' not in driver.page_source:
        print(f"    第{cycle_num}次 - 警告：我的页面未包含'退出登录'，可能点击未成功")
        screenshot(driver, f"warning_step7_{cycle_num}")

    # 8. 点击退出登录按钮
    print("\n[Step 8] 点击退出登录按钮...")

    logout_btn = None
    for wait_idx in range(10):
        try:
            all_buttons = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeButton')
            for btn in all_buttons:
                name = btn.get_attribute('name') or ''
                if ('退出登录' in name) and btn.is_displayed() and btn.is_enabled():
                    logout_btn = btn
                    print(f"    第{cycle_num}次 - 找到'退出登录'按钮(name={name})")
                    break
            if logout_btn:
                break
        except:
            pass
        time.sleep(1)

    if logout_btn:
        logout_btn.click()
        print(f"    第{cycle_num}次 - 已点击退出登录按钮")
    else:
        screenshot(driver, f"error_step8_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到'退出登录'按钮")

    # 9. 确认退出登录
    print("\n[Step 9] 确认退出登录...")

    time.sleep(2)

    confirm_success = False

    # 步骤1：获取并切换到 WebView context
    webview_ctx = None
    try:
        all_contexts = driver.contexts
        print(f"    可用 contexts: {all_contexts}")
        for ctx in all_contexts:
            if 'WEBVIEW' in ctx:
                webview_ctx = ctx
                break
    except Exception as e:
        print(f"    获取 contexts 失败: {e}")

    if webview_ctx:
        print(f"    切换到 WebView: {webview_ctx}")
        try:
            driver.switch_to.context(webview_ctx)
            time.sleep(1)
            print(f"    当前 context: {driver.current_context}")
        except Exception as e:
            print(f"    切换 WebView 失败: {e}")
            webview_ctx = None
    else:
        print(f"    未找到 WebView context")

    # 步骤2：在 WebView 下用 H5 定位方式点击确认按钮
    for attempt in range(3):
        confirm_success = False

        # 方法1：CSS selector - van-dialog__confirm（H5 确认按钮）
        try:
            confirm_btn = driver.find_element(By.CSS_SELECTOR, '.van-dialog__confirm')
            if confirm_btn.is_displayed():
                # 使用 JS click 绕过 Appium Touch API（WDA 只支持原生 Touch）
                driver.execute_script("arguments[0].click();", confirm_btn)
                print(f"    第{cycle_num}次 - JS click .van-dialog__confirm 成功")
                confirm_success = True
                break
        except Exception as e:
            print(f"    JS click .van-dialog__confirm 失败: {e}")

        # 方法2：XPath text 定位 + JS click
        try:
            confirm_btn = driver.find_element(By.XPATH, "//button[contains(text(),'确认')]")
            if confirm_btn.is_displayed():
                driver.execute_script("arguments[0].click();", confirm_btn)
                print(f"    第{cycle_num}次 - JS click //button[contains(text(),'确认')] 成功")
                confirm_success = True
                break
        except Exception as e:
            print(f"    JS click XPath 定位失败: {e}")

        # 方法3：CSS selector button.van-dialog__confirm + JS click
        try:
            confirm_btn = driver.find_element(By.CSS_SELECTOR, 'button.van-dialog__confirm')
            if confirm_btn.is_displayed():
                driver.execute_script("arguments[0].click();", confirm_btn)
                print(f"    第{cycle_num}次 - JS click button.van-dialog__confirm 成功")
                confirm_success = True
                break
        except Exception as e:
            print(f"    JS click button.van-dialog__confirm 失败: {e}")

        # 方法4：id 定位 + JS click
        try:
            confirm_btn = driver.find_element(By.ID, "confirmBtn")
            if confirm_btn.is_displayed():
                driver.execute_script("arguments[0].click();", confirm_btn)
                print(f"    第{cycle_num}次 - JS click #confirmBtn 成功")
                confirm_success = True
                break
        except Exception as e:
            print(f"    JS click ID 定位失败: {e}")

        if not confirm_success:
            print(f"    第{cycle_num}次 - 点击失败，重试第{attempt+1}次...")
            time.sleep(1)

    # 步骤3：切回原生 context
    if webview_ctx:
        try:
            driver.switch_to.context("NATIVE_APP")
            time.sleep(0.5)
            print(f"    已切回 NATIVE_APP")
        except:
            pass

    # 验证弹窗是否消失 - 等待一段时间后检查
    time.sleep(3)
    screenshot(driver, f"step9_verify_{cycle_num}")

    if '是否确认退出登录' not in driver.page_source:
        print(f"    第{cycle_num}次 - 弹窗已消失，确认退出成功")
        confirm_success = True
    else:
        print(f"    第{cycle_num}次 - 警告：弹窗仍在，退出未成功")
        screenshot(driver, f"warning_step9_{cycle_num}")

    # 进一步验证：检查是否回到登录页（身份证输入框存在）或已退出
    source = driver.page_source
    if '请输入身份证号码' in source and '客户登录' in source:
        print(f"    第{cycle_num}次 - 成功检测到登录界面，退出登录完成")
    elif '退出登录' not in source:
        print(f"    第{cycle_num}次 - '退出登录'按钮已消失，退出成功")
    else:
        print(f"    第{cycle_num}次 - 警告：页面状态不确定，可能退出未完全成功")

    # 等待退出完成
    time.sleep(3)
    screenshot(driver, f"step9_verify_{cycle_num}")

    # 验证是否成功退出 - 检查页面是否回到未登录状态
    # 未登录时：底部Tab显示"远程/自助/纯录制/我的"，"我的" Tab 不再显示用户信息
    # 已登录时："我的"页面会显示用户信息（姓名、手机号等）和"退出登录"按钮
    # 登出后：点击"我的" Tab 会显示登录入口（客户登录/客户经理登录按钮）
    source = driver.page_source

    # 检查是否仍在"我的"页面（包含用户信息或退出登录按钮）
    if '退出登录' not in source:
        print(f"    第{cycle_num}次 - 成功检测到已退出登录（'退出登录'按钮已消失）")
    elif '客户登录' in source and '请输入身份证号码' in source:
        print(f"    第{cycle_num}次 - 成功检测到登录界面，退出登录完成")
    else:
        # 尝试点击"我的" Tab 验证是否需要重新登录
        try:
            all_buttons = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeButton')
            for btn in all_buttons:
                name = btn.get_attribute('name') or ''
                if ('我的' in name) and btn.is_displayed():
                    btn.click()
                    time.sleep(2)
                    if '客户登录' in driver.page_source:
                        print(f"    第{cycle_num}次 - 点击'我的'后显示登录入口，确认退出成功")
                    else:
                        print(f"    第{cycle_num}次 - 点击'我的'后未显示登录入口，可能退出未完全成功")
                    break
        except:
            pass

    # 10. 点击 Home 键返回桌面
    print("\n[Step 10] 点击 Home 键返回桌面...")
    try:
        driver.execute_script("mobile: pressButton", {"name": "home"})
        print(f"    第{cycle_num}次 - 已点击 Home 键")
    except Exception as e:
        print(f"    Home 键点击失败: {e}")
    time.sleep(1)
    screenshot(driver, f"step10_home_{cycle_num}")

    print(f"\n第 {cycle_num} 次测试完成！")
    return True


def main():
    loop_count = 1

    if len(sys.argv) > 1:
        try:
            loop_count = int(sys.argv[1])
        except ValueError:
            loop_count = 1

    print("=" * 50)
    print("iOS App 双录自动化测试")
    print(f"Appium 地址: {APPIUM_URL}")
    print(f"WDA 地址: {WDA_URL}")
    print(f"UDID: {UDID}")
    print(f"Bundle ID: {BUNDLE_ID}")
    print(f"iOS 版本: {PLATFORM_VERSION}")
    print(f"循环次数: {loop_count} 次")
    print("=" * 50)

    success_count = 0
    fail_count = 0

    for i in range(1, loop_count + 1):
        driver = None
        try:
            options = get_desired_caps()
            driver = webdriver.Remote(APPIUM_URL, options=options)

            run_test_cycle(driver, i)
            success_count += 1

        except Exception as e:
            fail_count += 1
            print(f"\n[第 {i} 次测试失败] {str(e)}")
            if driver:
                try:
                    screenshot(driver, f"error_cycle_{i}")
                except:
                    pass
            print("    继续执行下一次测试...")

        finally:
            if driver:
                try:
                    driver.quit()
                except:
                    pass

        time.sleep(2)

    # 打印汇总结果
    print("\n" + "=" * 50)
    print("测试汇总")
    print("=" * 50)
    print(f"总循环次数: {loop_count}")
    print(f"成功次数: {success_count}")
    print(f"失败次数: {fail_count}")
    print(f"成功率: {success_count/loop_count*100:.1f}%")
    print("=" * 50)

    if fail_count > 0:
        sys.exit(1)


if __name__ == "__main__":
    main()