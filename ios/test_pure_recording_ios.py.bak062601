"""
iOS 原生 App UI 自动化测试脚本 - 纯录制业务流程
WDA: http://172.16.1.34:8100
Appium: http://172.16.1.34:4723
iOS UDID: 7720cc4ebea57931c047c2cdc0a9fbc5f6cf0c5c
Bundle ID: com.juphoon.record.ios
测试流程：
  1. 客户登录
  2. 点击"纯录制"菜单
  3. 订单列表点击"录制"按钮
  4. 弹窗确认
  5. 办理提示界面点击"同意并开始录制"
  6. 直播屏幕弹窗点击"开始直播"
  7. 3s倒计时后再次点击"同意并开始录制"
  8. 环境检测界面点击"同意检测"
  9. 分支处理：检测未通过/通过
支持循环执行
"""

import time
import os
import sys
from appium import webdriver
from appium.options.ios import XCUITestOptions
from appium.webdriver.common.appiumby import AppiumBy
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC


# 配置
WDA_URL = "http://172.16.1.39:8100"
APPIUM_URL = "http://172.16.1.39:4723"
UDID = "7720cc4ebea57931c047c2cdc0a9fbc5f6cf0c5c"
BUNDLE_ID = "com.juphoon.record.ios"
PLATFORM_VERSION = "17"

# 截图保存目录
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SCREENSHOT_DIR = os.path.join(SCRIPT_DIR, "screenshots_pure_recording")
os.makedirs(SCREENSHOT_DIR, exist_ok=True)

# 是否截图（默认关闭）
ENABLE_SCREENSHOT = os.environ.get("SCREENSHOT", "0") == "1"


def get_desired_caps():
    """获取 Appium 配置"""
    options = XCUITestOptions()
    options.set_capability("platformName", "iOS")
    options.set_capability("automationName", "XCUITest")
    options.set_capability("deviceName", "iPhone")
    options.set_capability("platformVersion", PLATFORM_VERSION)
    options.set_capability("udid", UDID)
    options.set_capability("bundleId", BUNDLE_ID)
    options.set_capability("webDriverAgentUrl", WDA_URL)
    options.set_capability("noReset", True)
    options.set_capability("fullReset", False)
    options.set_capability("newCommandTimeout", 300)
    options.set_capability("wdaConnectionTimeout", 60000)
    options.set_capability("autoAcceptAlerts", False)
    options.set_capability("skipLogCapture", True)
    options.set_capability("enableWebviewDetails", True)
    options.set_capability("autoWebview", False)
    options.set_capability("ensureWebviewsHavePages", True)
    options.set_capability("webviewConnectTimeout", 30000)
    options.set_capability("webkitDebugProxyPort", 9221)
    options.set_capability("showXcodeLog", True)
    options.set_capability("newCommandTimeout", 60)
    options.set_capability("webviewConnectRetries", 30)
    options.set_capability("nativeWebTap", True)
    options.set_capability("processArguments", {"args": ["-StartInBackground", "YES"]})
    return options


def grant_screen_capture_permission(driver):
    """预授予录屏权限，绕过ReplayKit弹窗"""
    print(f"    尝试预授予录屏权限...")
    try:
        # iOS14+ 预授予 ReplayKit 录屏权限
        driver.execute_script("mobile: setPermissions", {
            "bundleId": BUNDLE_ID,
            "permissions": {
                "screenCapture": "yes"
            }
        })
        print(f"    录屏权限预授予成功")
        return True
    except Exception as e:
        print(f"    录屏权限预授予失败: {e}")
        return False


def screenshot(driver, name):
    """截图保存（仅在启用时）"""
    if not ENABLE_SCREENSHOT:
        return
    path = os.path.join(SCREENSHOT_DIR, f"{name}.png")
    try:
        driver.save_screenshot(path)
        print(f"    截图: {path}")
    except Exception as e:
        print(f"    截图失败: {e}")
    return path


def click_element(driver, locators, check_enabled=True, timeout=5):
    """尝试多种方式点击元素"""
    start = time.time()
    while time.time() - start < timeout:
        for loc_type, loc_value in locators:
            try:
                if loc_type == "accessibility id":
                    elem = driver.find_element(AppiumBy.ACCESSIBILITY_ID, loc_value)
                elif loc_type == "xpath":
                    elem = driver.find_element(By.XPATH, loc_value)
                elif loc_type == "class name":
                    elem = driver.find_element(By.CLASS_NAME, loc_value)
                elif loc_type == "predicate":
                    elem = driver.find_element(AppiumBy.IOS_PREDICATE, loc_value)
                else:
                    elem = driver.find_element(By.XPATH, loc_value)

                if not elem.is_displayed():
                    continue
                if check_enabled and not elem.is_enabled():
                    time.sleep(0.1)
                    continue

                elem.click()
                return True, loc_type
            except:
                continue
        time.sleep(0.2)
    return False, None


def input_text(driver, locators, text, clear_first=True, timeout=5):
    """清空并输入文本"""
    start = time.time()
    while time.time() - start < timeout:
        for loc_type, loc_value in locators:
            try:
                if loc_type == "accessibility id":
                    elem = driver.find_element(AppiumBy.ACCESSIBILITY_ID, loc_value)
                elif loc_type == "xpath":
                    elem = driver.find_element(By.XPATH, loc_value)
                elif loc_type == "class name":
                    elem = driver.find_element(By.CLASS_NAME, loc_value)
                else:
                    elem = driver.find_element(By.XPATH, loc_value)

                if elem and elem.is_displayed():
                    # 使用set_value直接设置值，无需先清空（更快）
                    try:
                        elem.set_value(text)
                        return True
                    except:
                        # 兜底：使用传统方式
                        elem.click()
                        time.sleep(0.05)
                        if clear_first:
                            try:
                                elem.clear()
                            except:
                                pass
                        elem.send_keys(text)
                        return True
            except Exception as e:
                continue
        time.sleep(0.1)
    return False


def find_and_click_button(driver, name_pattern, timeout=15):
    """查找并点击按钮，支持多种匹配方式"""
    start = time.time()
    while time.time() - start < timeout:
        try:
            # 尝试 Predicate 方式
            buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
                f"name CONTAINS '{name_pattern}' AND type == 'XCUIElementTypeButton'")
            for btn in buttons:
                if btn.is_displayed() and btn.is_enabled():
                    btn.click()
                    return True
        except:
            pass

        # 兜底：遍历所有按钮
        try:
            all_buttons = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeButton')
            for btn in all_buttons:
                name = btn.get_attribute('name') or ''
                if name_pattern in name and btn.is_displayed() and btn.is_enabled():
                    btn.click()
                    return True
        except:
            pass
        time.sleep(0.2)
    return False


def wait_for_page_element(driver, check_func, timeout=30):
    """等待页面满足条件"""
    start = time.time()
    while time.time() - start < timeout:
        if check_func(driver.page_source):
            return True
        time.sleep(0.3)
    return False


def switch_to_webview(driver):
    """切换到 WebView 并返回是否成功"""
    try:
        for ctx in driver.contexts:
            if 'WEBVIEW' in ctx:
                driver.switch_to.context(ctx)
                return True
    except:
        pass
    return False


def switch_to_native(driver):
    """切换回原生"""
    try:
        driver.switch_to.context("NATIVE_APP")
    except:
        pass


def webview_click(driver, selectors):
    """在 WebView 中点击元素"""
    if not switch_to_webview(driver):
        return False

    for selector in selectors:
        try:
            if selector[0] == "css":
                btn = driver.find_element(By.CSS_SELECTOR, selector[1])
            elif selector[0] == "xpath":
                btn = driver.find_element(By.XPATH, selector[1])
            else:
                continue

            if btn.is_displayed():
                driver.execute_script("arguments[0].click();", btn)
                switch_to_native(driver)
                return True
        except:
            continue

    switch_to_native(driver)
    return False


def wait_countdown(driver, seconds=3):
    """等待倒计时"""
    print(f"    等待 {seconds}s 倒计时...")
    time.sleep(seconds + 0.5)  # 倒计时 + 缓冲


# ============================================================================
# 测试步骤函数
# ============================================================================

def step1_login(driver, cycle_num):
    """Step 1: 客户登录"""
    print("\n[Step 1] 客户登录...")

    try:
        driver.activate_app(BUNDLE_ID)
        print(f"    第{cycle_num}次 - 已启动 App")
    except Exception as e:
        print(f"    第{cycle_num}次 - 启动 App: {e}")

    # 用更高效的轮询等待"客户登录"按钮出现（Predicate + 0.2s间隔）
    btn_found = False
    for wait_idx in range(40):  # 40 * 0.2s = 8s max
        try:
            buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
                "name == '客户登录' AND type == 'XCUIElementTypeButton'")
            for btn in buttons:
                if btn.is_displayed():
                    btn_found = True
                    print(f"    第{cycle_num}次 - 客户登录按钮出现(iter {wait_idx})")
                    break
        except:
            pass
        if btn_found:
            break
        time.sleep(0.2)
    screenshot(driver, f"step1_launch_{cycle_num}")

    # 使用 Predicate 定位登录按钮
    login_btn = None
    try:
        buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
            "name == '客户登录' AND type == 'XCUIElementTypeButton'")
        for btn in buttons:
            if btn.is_displayed() and btn.is_enabled():
                login_btn = btn
                break
    except:
        pass

    if login_btn is None:
        success, loc_type = click_element(driver, [
            ("xpath", '//XCUIElementTypeButton[@name="客户登录"]'),
            ("xpath", '//*[contains(@name,"客户登录")]'),
            ("accessibility id", "客户登录"),
        ])
        if success:
            print(f"    第{cycle_num}次 - 已点击客户登录({loc_type})")
        else:
            screenshot(driver, f"error_step1_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'客户登录'按钮")
    else:
        login_btn.click()
        print(f"    第{cycle_num}次 - 已点击客户登录(Predicate)")

    # 等待登录表单出现
    for wait_idx in range(30):  # 30 * 0.3s = 9s max
        try:
            text_fields = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeTextField')
            if len(text_fields) >= 2:
                print(f"    第{cycle_num}次 - 登录表单出现(iter {wait_idx})")
                break
        except:
            pass
        time.sleep(0.3)
    screenshot(driver, f"step1_login_form_{cycle_num}")

    success = input_text(driver, [
        ("xpath", '//XCUIElementTypeTextField[@value="请输入身份证号码"]'),
        ("xpath", '//XCUIElementTypeTextField[contains(@value,"身份证")]'),
        ("xpath", '//XCUIElementTypeTextField[1]'),
    ], "411525200006040977", clear_first=True)
    if not success:
        screenshot(driver, f"error_step1_id_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到身份证输入框")
    print(f"    第{cycle_num}次 - 已输入身份证号")

    success = input_text(driver, [
        ("xpath", '//XCUIElementTypeSecureTextField[@value="请输入登录密码"]'),
        ("xpath", '//XCUIElementTypeSecureTextField[1]'),
    ], "Record123456", clear_first=False)
    if not success:
        screenshot(driver, f"error_step1_pwd_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到密码输入框")
    print(f"    第{cycle_num}次 - 已输入密码")

    success = input_text(driver, [
        ("xpath", '//XCUIElementTypeTextField[@value="请输入验证码"]'),
        ("xpath", '//XCUIElementTypeTextField[2]'),
    ], "0000", clear_first=True)
    if not success:
        screenshot(driver, f"error_step1_captcha_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到验证码输入框")
    print(f"    第{cycle_num}次 - 已输入验证码")

    # 使用 Predicate 定位登录按钮
    login_btn = None
    try:
        buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
            "name == '登录' AND type == 'XCUIElementTypeButton'")
        for btn in buttons:
            if btn.is_displayed() and btn.is_enabled():
                login_btn = btn
                break
    except:
        pass

    if login_btn:
        login_btn.click()
        print(f"    第{cycle_num}次 - 已点击登录按钮(Predicate)")
    else:
        success, loc_type = click_element(driver, [
            ("xpath", '//XCUIElementTypeButton[@name="登录"]'),
            ("xpath", '//XCUIElementTypeButton[contains(@name,"登录")]'),
        ])
        if success:
            print(f"    第{cycle_num}次 - 已点击登录按钮({loc_type})")
        else:
            screenshot(driver, f"error_step1_login_btn_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'登录'按钮")

    return True


def step2_click_self_service(driver, cycle_num):
    """Step 2: 点击"自助"菜单"""
    print("\n[Step 2] 点击'自助'菜单...")

    # 等待页面加载完成
    for wait_idx in range(20):
        source = driver.page_source
        if '自助' in source or '我的' in source:
            print(f"    第{cycle_num}次 - 页面已加载(iter {wait_idx})")
            break
        time.sleep(0.2)

    # 使用 Predicate 定位
    btn_found = False
    try:
        buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
            "name CONTAINS '自助' AND type == 'XCUIElementTypeButton'")
        for btn in buttons:
            if btn.is_displayed() and btn.is_enabled():
                btn.click()
                print(f"    第{cycle_num}次 - 已点击'自助'(Predicate)")
                btn_found = True
                break
    except:
        pass

    if not btn_found:
        success = find_and_click_button(driver, '自助', timeout=10)
        if success:
            print(f"    第{cycle_num}次 - 已点击'自助'")
        else:
            screenshot(driver, f"error_step2_self_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'自助'按钮")

    time.sleep(0.3)
    screenshot(driver, f"step2_self_service_{cycle_num}")
    return True


def step2_click_pure_recording(driver, cycle_num):
    """Step 2: 点击"纯录制"菜单"""
    print("\n[Step 2] 点击'纯录制'菜单...")

    # 等待页面加载完成
    for wait_idx in range(20):
        source = driver.page_source
        if '纯录制' in source or '我的' in source:
            print(f"    第{cycle_num}次 - 页面已加载(iter {wait_idx})")
            break
        time.sleep(0.2)

    # 使用 Predicate 定位
    btn_found = False
    try:
        buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
            "name CONTAINS '纯录制' AND type == 'XCUIElementTypeButton'")
        for btn in buttons:
            if btn.is_displayed() and btn.is_enabled():
                btn.click()
                print(f"    第{cycle_num}次 - 已点击'纯录制'(Predicate)")
                btn_found = True
                break
    except:
        pass

    if not btn_found:
        success = find_and_click_button(driver, '纯录制', timeout=15)
        if success:
            print(f"    第{cycle_num}次 - 已点击'纯录制'")
        else:
            screenshot(driver, f"error_step2_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'纯录制'按钮")

    time.sleep(0.5)
    screenshot(driver, f"step2_pure_recording_{cycle_num}")
    return True


def step3_click_record_in_list(driver, cycle_num):
    """Step 3: 订单列表点击'录制'按钮"""
    print("\n[Step 3] 订单列表点击'录制'按钮...")

    # 等待订单列表加载
    for wait_idx in range(20):
        source = driver.page_source
        if '录制' in source and '订单' in source:
            print(f"    第{cycle_num}次 - 订单列表已加载(iter {wait_idx})")
            break
        time.sleep(0.3)

    # 优先使用原生 Predicate 定位"录制"按钮
    try:
        buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
            "name == '录制' AND type == 'XCUIElementTypeButton'")
        for btn in buttons:
            if btn.is_displayed() and btn.is_enabled():
                btn.click()
                print(f"    第{cycle_num}次 - 原生Predicate点击'录制'成功")
                time.sleep(0.5)
                screenshot(driver, f"step3_record_btn_{cycle_num}")
                return True
    except:
        pass

    # 兜底：遍历所有按钮找"录制"
    try:
        all_buttons = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeButton')
        for btn in all_buttons:
            name = btn.get_attribute('name') or ''
            if name == '录制' and btn.is_displayed() and btn.is_enabled():
                btn.click()
                print(f"    第{cycle_num}次 - 原生遍历点击'录制'成功")
                time.sleep(0.5)
                screenshot(driver, f"step3_record_btn_{cycle_num}")
                return True
    except:
        pass

    # 最后尝试 WebView
    if webview_click(driver, [
        ("xpath", "//button[contains(text(),'录制')]"),
        ("xpath", "//*[contains(@class,'btn') and contains(text(),'录制')]"),
    ]):
        print(f"    第{cycle_num}次 - WebView点击'录制'成功")
        time.sleep(0.5)
        screenshot(driver, f"step3_record_btn_{cycle_num}")
        return True

    screenshot(driver, f"error_step3_{cycle_num}")
    raise Exception(f"第{cycle_num}次 - 未找到'录制'按钮")


def step4_confirm_popup(driver, cycle_num):
    """Step 4: 弹窗确认"""
    print("\n[Step 4] 弹窗点击'确定'...")

    #动态等待弹窗出现（最多等待3s）
    popup_found = False
    for wait_idx in range(10):  # 10 * 0.3 = 3s
        source = driver.page_source
        if '确定' in source or '确认' in source or '录制' in source:
            print(f"    第{cycle_num}次 - 弹窗元素检测到(iter {wait_idx})")
            popup_found = True
            break
        time.sleep(0.3)

    # 直接尝试最高效的方式：WebView 点击
    if webview_click(driver, [
        ("css", '.van-dialog__confirm'),
        ("css", 'button.van-dialog__confirm'),
        ("xpath", "//button[contains(text(),'确认')]"),
        ("xpath", "//button[contains(text(),'确定')]"),
    ]):
        print(f"    第{cycle_num}次 - WebView点击'确认'成功")
        time.sleep(0.3)
        screenshot(driver, f"step4_confirm_{cycle_num}")
        return True

    # 尝试 Appium mobile alert 命令
    try:
        driver.execute_script("mobile: alert", {"action": "accept"})
        print(f"    第{cycle_num}次 - mobile:alert accept 成功")
        time.sleep(0.3)
        screenshot(driver, f"step4_confirm_{cycle_num}")
        return True
    except:
        pass

    # 尝试原生 Alert
    try:
        WebDriverWait(driver, 2).until(EC.alert_is_present())
        alert = driver.switch_to.alert
        alert.accept()
        print(f"    第{cycle_num}次 - 原生Alert确认成功")
        time.sleep(0.3)
        screenshot(driver, f"step4_confirm_{cycle_num}")
        return True
    except:
        pass

    # 尝试原生 iOS 按钮
    try:
        alert_buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
            "type == 'XCUIElementTypeButton' AND (name == '确定' OR name == '确认')")
        for btn in alert_buttons:
            if btn.is_displayed():
                btn.click()
                print(f"    第{cycle_num}次 - iOS原生按钮点击成功")
                time.sleep(0.3)
                screenshot(driver, f"step4_confirm_{cycle_num}")
                return True
    except:
        pass

    # 兜底：遍历所有按钮找"确定"或"确认"
    try:
        all_buttons = driver.find_elements(By.CLASS_NAME, 'XCUIElementTypeButton')
        for btn in all_buttons:
            name = btn.get_attribute('name') or ''
            if ('确定' in name or '确认' in name) and btn.is_displayed():
                btn.click()
                print(f"    第{cycle_num}次 - 兜底点击'确定'成功")
                time.sleep(0.3)
                screenshot(driver, f"step4_confirm_{cycle_num}")
                return True
    except:
        pass

    screenshot(driver, f"error_step4_{cycle_num}")
    raise Exception(f"第{cycle_num}次 - 未找到'确定'按钮")


def step5_click_agree_and_start(driver, cycle_num):
    """Step 5: 点击'同意并开始录制'"""
    print("\n[Step 5] 点击'同意并开始录制'...")

    # 等待按钮出现并可点击
    btn_found = False
    for wait_idx in range(30):
        source = driver.page_source
        if '同意并开始双录' in source or '同意并开始录制' in source:
            print(f"    第{cycle_num}次 - 检测到按钮元素(iter {wait_idx})")

            # 尝试找到按钮并点击
            try:
                buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
                    "(name CONTAINS '同意并开始双录' OR name CONTAINS '同意并开始录制') AND type == 'XCUIElementTypeButton'")
                for btn in buttons:
                    if btn.is_displayed():
                        # 如果按钮不可用，尝试滚动
                        if not btn.is_enabled():
                            print(f"    第{cycle_num}次 - 按钮禁用，尝试滚动...")
                            # 向上滚动
                            driver.execute_script("mobile: scroll", {"direction": "up"})
                            time.sleep(0.5)
                            continue
                        btn.click()
                        print(f"    第{cycle_num}次 - 点击'同意并开始录制'成功")
                        btn_found = True
                        break
            except:
                pass

            if btn_found:
                break

        time.sleep(0.5)

    if not btn_found:
        # 最后尝试：使用 WebView 或 JS 点击
        if webview_click(driver, [
            ("xpath", "//button[contains(text(),'同意并开始双录')]"),
            ("xpath", "//button[contains(text(),'同意并开始录制')]"),
            ("css", "button.agree-btn"),
        ]):
            print(f"    第{cycle_num}次 - WebView点击'同意并开始录制'成功")
            btn_found = True

    if not btn_found:
        screenshot(driver, f"error_step5_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到'同意并开始录制'按钮")

    time.sleep(0.3)
    screenshot(driver, f"step5_agree_{cycle_num}")
    return True


def step6_click_start_live(driver, cycle_num):
    """Step 6: 点击'开始直播' - 使用坐标点击"""
    print("\n[Step 6] 点击'开始直播'...")

    # 截图调试：点击前截图
    screenshot(driver, f"step6_before_start_live_{cycle_num}")

    # 等待弹窗加载完成
    time.sleep(0.5)

    # 方案1：iOS Class Chain（最优、稳定）
    print(f"    第{cycle_num}次 - 尝试 IOS_CLASS_CHAIN 定位...")
    try:
        btn = driver.find_element(AppiumBy.IOS_CLASS_CHAIN,
            '**/XCUIElementTypeButton[`label == "开始直播"`]')
        if btn.is_displayed():
            btn.click()
            print(f"    第{cycle_num}次 - ClassChain点击'开始直播'成功")
            time.sleep(0.5)
            screenshot(driver, f"step6_start_live_{cycle_num}")
            return True
    except Exception as e:
        print(f"    第{cycle_num}次 - ClassChain 失败: {e}")

    # 方案2：iOS NSPredicate 谓词定位
    print(f"    第{cycle_num}次 - 尝试 NSPredicate 定位...")
    try:
        btn = driver.find_element(AppiumBy.IOS_PREDICATE,
            'label == "开始直播" AND type == "XCUIElementTypeButton"')
        if btn.is_displayed():
            btn.click()
            print(f"    第{cycle_num}次 - Predicate点击'开始直播'成功")
            time.sleep(0.5)
            screenshot(driver, f"step6_start_live_{cycle_num}")
            return True
    except Exception as e:
        print(f"    第{cycle_num}次 - Predicate 失败: {e}")

    # 方案3：坐标点击（百分比定位，适配所有iPhone竖屏）
    print(f"    第{cycle_num}次 - 尝试坐标点击...")
    try:
        window_size = driver.get_window_size()
        w = window_size["width"]
        h = window_size["height"]
        tap_x = int(w * 0.5)
        tap_y = int(h * 0.67)
        print(f"    第{cycle_num}次 - 屏幕尺寸: {w}x{h}, 点击坐标: ({tap_x}, {tap_y})")
        driver.tap([(tap_x, tap_y)])
        print(f"    第{cycle_num}次 - 坐标点击成功")
        time.sleep(0.5)
        screenshot(driver, f"step6_start_live_{cycle_num}")
        return True
    except Exception as e:
        print(f"    第{cycle_num}次 - 坐标点击失败: {e}")

    # 截图调试：最终失败截图
    screenshot(driver, f"error_step6_{cycle_num}")
    raise Exception(f"第{cycle_num}次 - 未找到'开始直播'按钮")


def step7_wait_countdown_and_agree(driver, cycle_num):
    """Step 7: 3s倒计时后点击'同意检测'
    注意：如果界面已显示检测未通过（有"跳过"按钮），则跳过此步骤
    """
    print("\n[Step 7] 等待3s倒计时后点击'同意检测'...")

    wait_countdown(driver, 3)

    # 先检查当前界面是否已经是检测未通过界面（有"跳过"按钮）
    page_source = driver.page_source
    if '跳过' in page_source and '重新检测' in page_source:
        print(f"    第{cycle_num}次 - 已是检测未通过界面，跳过等待")
        screenshot(driver, f"step7_skip_{cycle_num}")
        return True

    # 点击"同意检测"按钮
    success = find_and_click_button(driver, '同意检测', timeout=15)
    if success:
        print(f"    第{cycle_num}次 - 已点击'同意检测'")
    else:
        screenshot(driver, f"error_step7_{cycle_num}")
        raise Exception(f"第{cycle_num}次 - 未找到'同意检测'按钮")

    time.sleep(0.3)
    screenshot(driver, f"step7_agree_{cycle_num}")
    return True


def step8_self_service_detection(driver, cycle_num):
    """Step 8: 自助业务 - 检测结果分支处理
    逻辑：
    1. 等待页面判断是"检测未通过"还是"检测通过"
    2. 如果检测未通过 → 点击"跳过" → 自动跳转到播报节点
    3. 如果检测通过，自动跳转到播报节点
    4. 播报+朗读自动完成（约24s），跳转到业务办理完成界面
    5. 点击业务完成弹窗确认
    注意：自助业务流程没有"完成录制"按钮
    """
    print("\n[Step 8] 自助业务检测结果分支处理...")

    # 先等待判断当前页面状态
    page_state = None
    for wait_idx in range(15):
        source = driver.page_source
        if '重新检测' in source or '跳过' in source:
            page_state = 'detect_fail'
            print(f"    第{cycle_num}次 - 检测未通过界面(iter {wait_idx})")
            break
        if '开始录制' in source:
            page_state = 'detect_pass'
            print(f"    第{cycle_num}次 - 检测通过界面(iter {wait_idx})")
            break
        time.sleep(0.5)

    if page_state == 'detect_fail':
        # 分支1：检测未通过 → 点击"跳过" → 自动跳转到播报节点
        print(f"    第{cycle_num}次 - [分支1] 检测未通过，点击跳过")

        success = find_and_click_button(driver, '跳过', timeout=10)
        if success:
            print(f"    第{cycle_num}次 - 已点击'跳过'")
        else:
            screenshot(driver, f"error_step8_skip_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'跳过'按钮")

        time.sleep(0.3)
        screenshot(driver, f"step8_skip_{cycle_num}")

        # 风险提示弹窗 - 点击确认
        if webview_click(driver, [
            ("css", '.van-dialog__confirm'),
            ("css", 'button.van-dialog__confirm'),
            ("xpath", "//button[contains(text(),'确认')]"),
        ]):
            print(f"    第{cycle_num}次 - 风险提示弹窗点击'确认'成功")
        else:
            success, _ = click_element(driver, [
                ("predicate", "name CONTAINS '确认' AND type == 'XCUIElementTypeButton'"),
                ("xpath", '//XCUIElementTypeButton[@name="确认"]'),
            ], timeout=5)
            if success:
                print(f"    第{cycle_num}次 - 原生点击'确认'成功")

        time.sleep(0.5)
        screenshot(driver, f"step8_risk_confirm_{cycle_num}")

    else:
        # 分支2：检测通过 → 直接进入播报节点
        print(f"    第{cycle_num}次 - [分支2] 检测通过，自动进入播报流程")

    # ========== 公共逻辑：等待播报+朗读完成（约24s）==========
    # 等待播报节点出现
    print(f"    第{cycle_num}次 - 等待播报节点出现...")
    broadcast_appeared = False
    for wait_idx in range(60):  # 60 * 0.5 = 30s
        source = driver.page_source
        if '下一步' in source or '播报' in source or '朗读' in source or '业务办理' in source:
            print(f"    第{cycle_num}次 - 播报节点出现(iter {wait_idx})")
            broadcast_appeared = True
            break
        time.sleep(0.5)

    if not broadcast_appeared:
        # 等待超时，直接截图并继续（可能已自动跳过播报）
        print(f"    第{cycle_num}次 - 播报节点未出现，继续等待...")

    screenshot(driver, f"step8_broadcast_{cycle_num}")

    # 等待播报完成并点击"下一步"进入朗读节点（约24s）
    print(f"    第{cycle_num}次 - 等待播报+朗读完成（约24s）...")
    business_ready = False
    for wait_idx in range(80):  # 80 * 0.3 = 24s
        source = driver.page_source

        # 检查并点击"下一步"按钮进入朗读节点
        if '下一步' in source:
            try:
                buttons = driver.find_elements(AppiumBy.IOS_PREDICATE,
                    "name == '下一步' AND type == 'XCUIElementTypeButton'")
                for btn in buttons:
                    if btn.is_displayed() and btn.is_enabled():
                        btn.click()
                        print(f"    第{cycle_num}次 - 已点击'下一步'(播报->朗读)")
                        time.sleep(0.5)
                        break
            except:
                pass

        # 检查是否到达业务办理完成界面
        if '业务办理' in source or '完成' in source:
            print(f"    第{cycle_num}次 - 业务办理完成界面出现(iter {wait_idx})")
            business_ready = True
            break
        if '朗读' in source:
            print(f"    第{cycle_num}次 - 朗读节点出现(iter {wait_idx})")
        time.sleep(0.3)

    screenshot(driver, f"step8_broadcast_done_{cycle_num}")

    # 如果还没到业务办理完成界面，继续等待
    if not business_ready:
        print(f"    第{cycle_num}次 - 等待业务办理完成界面...")
        for wait_idx in range(30):
            source = driver.page_source
            if '业务办理' in source or '完成' in source:
                print(f"    第{cycle_num}次 - 业务办理完成界面出现(iter {wait_idx})")
                business_ready = True
                break
            time.sleep(0.3)

    # 业务办理完成界面不需要点击确认，直接等待返回按钮出现
    print(f"    第{cycle_num}次 - 业务办理完成界面已到达")
    time.sleep(1)
    screenshot(driver, f"step8_business_complete_{cycle_num}")

    return True


def step8_pure_record_detection(driver, cycle_num):
    """Step 8: 纯录制业务 - 点击'开始录制'（检测结果分支处理）"""
    print("\n[Step 8] 纯录制业务检测结果处理...")

    # 先等待判断当前页面状态
    page_state = None
    for wait_idx in range(15):
        source = driver.page_source
        if '重新检测' in source or '跳过' in source:
            page_state = 'detect_fail'
            print(f"    第{cycle_num}次 - 检测未通过界面(iter {wait_idx})")
            break
        if '开始录制' in source:
            page_state = 'detect_pass'
            print(f"    第{cycle_num}次 - 检测通过界面(iter {wait_idx})")
            break
        time.sleep(0.5)

    if page_state == 'detect_fail':
        # 检测未通过分支 - 点击"跳过"
        success = find_and_click_button(driver, '跳过', timeout=10)
        if success:
            print(f"    第{cycle_num}次 - 已点击'跳过'")
        else:
            screenshot(driver, f"error_step8_skip_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'跳过'按钮")

        time.sleep(0.3)
        screenshot(driver, f"step8_skip_{cycle_num}")

        # 风险提示弹窗 - 点击确认
        if webview_click(driver, [
            ("css", '.van-dialog__confirm'),
            ("css", 'button.van-dialog__confirm'),
            ("xpath", "//button[contains(text(),'确认')]"),
        ]):
            print(f"    第{cycle_num}次 - 风险提示弹窗点击'确认'成功")
        else:
            success, _ = click_element(driver, [
                ("predicate", "name CONTAINS '确认' AND type == 'XCUIElementTypeButton'"),
                ("xpath", '//XCUIElementTypeButton[@name="确认"]'),
            ], timeout=5)
            if success:
                print(f"    第{cycle_num}次 - 原生点击'确认'成功")

        time.sleep(0.5)
        screenshot(driver, f"step8_risk_confirm_{cycle_num}")

        # 等待"开始录制"按钮
        success = find_and_click_button(driver, '开始录制', timeout=20)
        if success:
            print(f"    第{cycle_num}次 - 已点击'开始录制'")
        else:
            screenshot(driver, f"error_step8_start_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'开始录制'按钮")

        time.sleep(0.3)
        screenshot(driver, f"step8_start_record_{cycle_num}")
    else:
        # 检测通过分支 - 直接点击"开始录制"
        success = find_and_click_button(driver, '开始录制', timeout=15)
        if success:
            print(f"    第{cycle_num}次 - 已点击'开始录制'")
        else:
            screenshot(driver, f"error_step8_{cycle_num}")
            raise Exception(f"第{cycle_num}次 - 未找到'开始录制'按钮")

        time.sleep(0.3)
        screenshot(driver, f"step8_start_record_{cycle_num}")

    return True


def step8_click_agree_detection(driver, cycle_num):
    """Step 8: 点击'开始录制'（根据检测结果分支处理）- 兼容性别名，实际分发到具体业务"""
    # 根据当前业务类型选择对应的处理函数
    # 此处默认走纯录制逻辑，自助业务会直接调用step8_self_service_detection
    return step8_pure_record_detection(driver, cycle_num)


